#!/bin/sh
# pre-push: incrementa a versão (build) automaticamente a cada push e cria um
# commit "chore: bump version" que entra no mesmo push. Para funcionar, o
# repositório usa este diretório como hooksPath:
#   git config core.hooksPath .githooks
set -e

node scripts/bump-version.mjs

# Só cria o commit de versão se houver mudança de fato (bump gerou algo novo).
if git diff --quiet version.json client/public/version.json; then
  exit 0
fi

git add version.json client/public/version.json
VERSION=$(node -p "JSON.parse(require('fs').readFileSync('version.json','utf8')).version")
BUILD=$(node -p "JSON.parse(require('fs').readFileSync('version.json','utf8')).build")
git commit --no-verify -m "chore: bump version para v${VERSION} (build ${BUILD})" >/dev/null 2>&1 || true

exit 0

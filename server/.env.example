SERVER_PORT=3000
WS_PORT=3001
UDP_PORT=3002
MAX_USERS=100
MAX_ROOMS=20
DB_PATH=./data/voip.db
ADMIN_NAMES=Diretor,Operador
ADMIN_IDS=7iz9enux
LOG_LEVEL=INFO
# Limites de segurança (bytes/tamanho máx de payload)
MAX_NAME_LENGTH=32
MAX_PASSWORD_LENGTH=128
MAX_ROOM_NAME_LENGTH=64
MAX_TEXT_LENGTH=4000
MAX_AUDIO_MESSAGE_BYTES=524288
MAX_VIDEO_MESSAGE_BYTES=2097152
MAX_LIVE_CHUNK_BYTES=524288
MAX_VOICE_FRAME_BYTES=65536
MAX_AVATAR_BYTES=2097152
MAX_IMAGE_MESSAGE_BYTES=5242880
MAX_WS_PAYLOAD=8388608
# SMTP (envio de e-mail de confirmação de conta)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@voip.local
APP_NAME=VoIP Rádio Pelotense
